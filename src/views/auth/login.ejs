<%- include('../partials/cabecera') %>

<section class="tarjeta tarjeta-auth">
  <h1>Iniciar sesión</h1>
  <p class="sub">Acceso exclusivo para el personal administrativo.</p>

  <% if (typeof error !== 'undefined') { %>
    <div class="alerta alerta-error"><%= error %></div>
  <% } %>

  <form action="/login" method="POST" class="formulario">
    <input type="hidden" name="volver" value="<%= volver %>">

    <label for="usuario">Usuario</label>
    <input id="usuario" name="usuario" value="<%= valores.usuario || '' %>" required autofocus autocomplete="username">

    <label for="password">Contraseña</label>
    <input id="password" name="password" type="password" required autocomplete="current-password">

    <button type="submit" class="btn btn-primario btn-bloque">Ingresar</button>
  </form>

  <p class="nota">¿No tienes cuenta? <a href="/registro">Regístrate</a></p>
</section>

<%- include('../partials/pie') %>
