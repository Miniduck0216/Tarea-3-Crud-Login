<%- include('../partials/cabecera') %>

<% const editando = Boolean(empleado.id); %>

<section class="tarjeta">
  <h1><%= titulo %></h1>

  <% if (errores.length) { %>
    <div class="alerta alerta-error">
      <ul><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul>
    </div>
  <% } %>

  <form action="<%= editando ? `/empleados/${empleado.id}?_method=PUT` : '/empleados' %>" method="POST" class="formulario">
    <label for="nombre">Nombre completo</label>
    <input id="nombre" name="nombre" value="<%= empleado.nombre || '' %>" maxlength="100" required>

    <label for="correo">Correo corporativo</label>
    <input id="correo" name="correo" type="email" value="<%= empleado.correo || '' %>" required>

    <div class="fila">
      <div>
        <label for="cargo">Cargo</label>
        <input id="cargo" name="cargo" value="<%= empleado.cargo || '' %>" required>
      </div>
      <div>
        <label for="departamento">Departamento</label>
        <select id="departamento" name="departamento" required>
          <option value="">Selecciona…</option>
          <% departamentos.forEach(d => { %>
            <option value="<%= d %>" <%= empleado.departamento === d ? 'selected' : '' %>><%= d %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="fila">
      <div>
        <label for="salario">Salario mensual (USD)</label>
        <input id="salario" name="salario" type="number" step="0.01" min="0" value="<%= empleado.salario ?? '' %>" required>
      </div>
      <div>
        <label for="fecha_ingreso">Fecha de ingreso</label>
        <input id="fecha_ingreso" name="fecha_ingreso" type="date" value="<%= empleado.fecha_ingreso || '' %>" required>
      </div>
    </div>

    <div class="botones">
      <a href="/empleados" class="btn btn-texto">Cancelar</a>
      <button type="submit" class="btn btn-primario"><%= editando ? 'Guardar cambios' : 'Registrar empleado' %></button>
    </div>
  </form>
</section>

<%- include('../partials/pie') %>
